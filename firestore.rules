rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validImageUrl(value) {
      return value == null ||
          (value is string &&
              value.size() <= 2048 &&
              value.matches('^https://.+'));
    }

    function validTreasurePoint(data) {
      return data.keys().hasAll([
        'name',
        'description',
        'latitude',
        'longitude',
        'qrCode',
        'type',
        'order',
          ]) &&
          data.keys().hasOnly([
            'name',
            'description',
            'latitude',
            'longitude',
            'qrCode',
            'type',
            'order',
          ]) &&
          data.name is string &&
          data.name.size() > 0 &&
          data.name.size() <= 120 &&
          data.description is string &&
          data.description.size() > 0 &&
          data.description.size() <= 2000 &&
          data.latitude is number &&
          data.latitude >= -90 &&
          data.latitude <= 90 &&
          data.longitude is number &&
          data.longitude >= -180 &&
          data.longitude <= 180 &&
          data.qrCode is string &&
          data.qrCode.size() <= 2048 &&
          data.type is string &&
          data.type in ['treasurePoint', 'pointOfInterest'] &&
          data.order is int &&
          data.order >= 0;
    }

    function validWikiArticle(data) {
      return data.keys().hasAll([
        'title',
        'content',
        'category',
        'tags',
        'treasurePointIds',
          ]) &&
          data.keys().hasOnly([
            'title',
            'content',
            'category',
            'imageUrl',
            'tags',
            'treasurePointIds',
          ]) &&
          data.title is string &&
          data.title.size() > 0 &&
          data.title.size() <= 160 &&
          data.content is string &&
          data.content.size() > 0 &&
          data.content.size() <= 20000 &&
          data.category is string &&
          data.category.size() > 0 &&
          data.category.size() <= 80 &&
          validImageUrl(data.imageUrl) &&
          data.tags is list &&
          data.tags.size() <= 20 &&
          data.treasurePointIds is list &&
          data.treasurePointIds.size() <= 100;
    }

    function validTimetableEvent(data) {
      return data.keys().hasAll([
        'title',
        'description',
        'startTime',
        'endTime',
        'location',
        'tags',
        'treasurePointIds',
          ]) &&
          data.keys().hasOnly([
            'title',
            'description',
            'startTime',
            'endTime',
            'location',
            'imageUrl',
            'tags',
            'treasurePointIds',
          ]) &&
          data.title is string &&
          data.title.size() > 0 &&
          data.title.size() <= 160 &&
          data.description is string &&
          data.description.size() > 0 &&
          data.description.size() <= 4000 &&
          data.startTime is string &&
          data.startTime.size() > 0 &&
          data.endTime is string &&
          data.endTime.size() > 0 &&
          data.location is string &&
          data.location.size() > 0 &&
          data.location.size() <= 200 &&
          validImageUrl(data.imageUrl) &&
          data.tags is list &&
          data.tags.size() <= 20 &&
          data.treasurePointIds is list &&
          data.treasurePointIds.size() <= 100;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /treasure_points/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validTreasurePoint(request.resource.data);
      allow delete: if isAdmin();
    }

    match /wiki_articles/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validWikiArticle(request.resource.data);
      allow delete: if isAdmin();
    }

    match /timetable_events/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validTimetableEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}