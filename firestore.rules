rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
          exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validImageUrl(value) {
      return value == null ||
          (value is string &&
              value.size() <= 2048 &&
              value.matches('^https://.+'));
    }

    function validTreasurePoint(data) {
      return data.keys().hasAll([
        'name',
        'description',
        'latitude',
        'longitude',
        'qrCode',
        'type',
        'order',
          ]) &&
          data.keys().hasOnly([
            'name',
            'description',
            'latitude',
            'longitude',
            'qrCode',
            'type',
            'order',
          ]) &&
          data.name is string &&
          data.name.size() > 0 &&
          data.name.size() <= 120 &&
          data.description is string &&
          data.description.size() > 0 &&
          data.description.size() <= 2000 &&
          data.latitude is number &&
          data.latitude >= -90 &&
          data.latitude <= 90 &&
          data.longitude is number &&
          data.longitude >= -180 &&
          data.longitude <= 180 &&
          data.qrCode is string &&
          data.qrCode.size() <= 2048 &&
          data.type is string &&
          data.type in ['treasurePoint', 'pointOfInterest'] &&
          data.order is int &&
          data.order >= 0;
    }

    function validWikiArticle(data) {
      return data.keys().hasAll([
        'title',
        'content',
        'category',
        'tags',
        'treasurePointIds',
          ]) &&
          data.keys().hasOnly([
            'title',
            'content',
            'category',
            'imageUrl',
            'tags',
            'treasurePointIds',
          ]) &&
          data.title is string &&
          data.title.size() > 0 &&
          data.title.size() <= 160 &&
          data.content is string &&
          data.content.size() > 0 &&
          data.content.size() <= 20000 &&
          data.category is string &&
          data.category.size() > 0 &&
          data.category.size() <= 80 &&
          validImageUrl(data.imageUrl) &&
          data.tags is list &&
          data.tags.size() <= 20 &&
          data.treasurePointIds is list &&
          data.treasurePointIds.size() <= 100;
    }

    function validTimetableEvent(data) {
      return data.keys().hasAll([
        'title',
        'description',
        'startTime',
        'endTime',
        'location',
        'tags',
        'treasurePointIds',
          ]) &&
          data.keys().hasOnly([
            'title',
            'description',
            'startTime',
            'endTime',
            'location',
            'imageUrl',
            'tags',
            'treasurePointIds',
          ]) &&
          data.title is string &&
          data.title.size() > 0 &&
          data.title.size() <= 160 &&
          data.description is string &&
          data.description.size() > 0 &&
          data.description.size() <= 4000 &&
          data.startTime is string &&
          data.startTime.size() > 0 &&
          data.endTime is string &&
          data.endTime.size() > 0 &&
          data.location is string &&
          data.location.size() > 0 &&
          data.location.size() <= 200 &&
          validImageUrl(data.imageUrl) &&
          data.tags is list &&
          data.tags.size() <= 20 &&
          data.treasurePointIds is list &&
          data.treasurePointIds.size() <= 100;
    }

    function validNotificationToken(data, installId) {
      return data.keys().hasAll([
        'installationId',
        'token',
        'platform',
        'enabled',
        'updatedAt',
          ]) &&
          data.keys().hasOnly([
            'installationId',
            'token',
            'platform',
            'enabled',
            'updatedAt',
          ]) &&
          data.installationId == installId &&
          data.installationId is string &&
          data.installationId.size() >= 16 &&
          data.installationId.size() <= 64 &&
          data.token is string &&
          data.token.size() >= 20 &&
          data.token.size() <= 4096 &&
          data.platform is string &&
          data.platform in [
            'android',
            'ios',
            'web',
            'macos',
            'linux',
            'windows',
            'unknown',
          ] &&
          data.enabled is bool &&
          data.updatedAt == request.time;
    }

    function validNotificationBroadcast(data) {
      return data.keys().hasAll([
        'title',
        'body',
        'status',
        'createdBy',
        'createdAt',
          ]) &&
          data.keys().hasOnly([
            'title',
            'body',
            'status',
            'createdBy',
            'createdAt',
          ]) &&
          data.title is string &&
          data.title.size() > 0 &&
          data.title.size() <= 80 &&
          data.body is string &&
          data.body.size() > 0 &&
          data.body.size() <= 240 &&
          data.status == 'queued' &&
          data.createdBy == request.auth.uid &&
          data.createdAt == request.time;
    }

    function validLeaderboardEntry(data, participantId) {
      return data.keys().hasAll([
        'participantId',
        'displayName',
        'totalScore',
        'foundPointScore',
        'treasureScore',
        'checkInScore',
        'updatedAt',
          ]) &&
          data.keys().hasOnly([
            'participantId',
            'displayName',
            'totalScore',
            'foundPointScore',
            'treasureScore',
            'checkInScore',
            'updatedAt',
          ]) &&
          data.participantId == participantId &&
          data.participantId is string &&
          data.participantId.size() >= 16 &&
          data.participantId.size() <= 64 &&
          data.displayName is string &&
          data.displayName.size() > 0 &&
          data.displayName.size() <= 32 &&
          data.totalScore is int &&
          data.foundPointScore is int &&
          data.treasureScore is int &&
          data.checkInScore is int &&
          data.totalScore >= 0 &&
          data.totalScore <= 1000 &&
          data.foundPointScore >= 0 &&
          data.foundPointScore <= 500 &&
          data.treasureScore >= 0 &&
          data.treasureScore <= data.foundPointScore &&
          data.checkInScore >= 0 &&
          data.checkInScore <= 500 &&
          data.totalScore == data.foundPointScore + data.checkInScore &&
          data.updatedAt == request.time;
    }

    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /treasure_points/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validTreasurePoint(request.resource.data);
      allow delete: if isAdmin();
    }

    match /wiki_articles/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validWikiArticle(request.resource.data);
      allow delete: if isAdmin();
    }

    match /timetable_events/{docId} {
      allow read: if true;
      allow create, update: if isAdmin() && validTimetableEvent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /notification_tokens/{installId} {
      allow read: if false;
      allow create, update: if validNotificationToken(request.resource.data, installId);
      allow delete: if false;
    }

    match /notification_broadcasts/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && validNotificationBroadcast(request.resource.data);
      allow update, delete: if false;
    }

    match /leaderboard_entries/{participantId} {
      allow read: if true;
      allow create, update: if isSignedIn() &&
        request.auth.uid == participantId &&
        validLeaderboardEntry(request.resource.data, participantId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
