platform :ios, '15.0'

require 'json'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(
    File.join('..', 'Flutter', 'Generated.xcconfig'),
    __FILE__,
  )

  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. Run flutter pub get before pod install."
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end

  raise 'FLUTTER_ROOT not found in Generated.xcconfig. Run flutter pub get before pod install.'
end

def firebase_ios_sdk_version
  flutter_plugins_dependencies_path = File.expand_path(
    File.join('..', '.flutter-plugins-dependencies'),
    __FILE__,
  )

  unless File.exist?(flutter_plugins_dependencies_path)
    raise "#{flutter_plugins_dependencies_path} must exist. Run flutter pub get before pod install."
  end

  plugins = JSON.parse(File.read(flutter_plugins_dependencies_path))
  ios_plugins = plugins.fetch('plugins', {}).fetch('ios', [])
  firebase_core_plugin = ios_plugins.find { |plugin| plugin['name'] == 'firebase_core' }

  unless firebase_core_plugin
    raise 'firebase_core iOS plugin metadata not found in .flutter-plugins-dependencies. Run flutter pub get before pod install.'
  end

  firebase_core_script = File.expand_path(
    File.join(firebase_core_plugin.fetch('path'), 'ios', 'firebase_sdk_version.rb'),
  )

  unless File.exist?(firebase_core_script)
    raise "#{firebase_core_script} must exist. Run flutter pub get before pod install."
  end

  require firebase_core_script
  firebase_sdk_version!
end

require File.expand_path(
  File.join('packages', 'flutter_tools', 'bin', 'podhelper'),
  flutter_root,
)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  pod 'FirebaseFirestore',
    :git => 'https://github.com/invertase/firestore-ios-sdk-frameworks.git',
    :tag => firebase_ios_sdk_version

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_NOTIFICATIONS=1',
        'PERMISSION_PHOTOS=1',
        'BYPASS_PERMISSION_LOCATION_ALWAYS=1',
      ]
    end
  end
end
