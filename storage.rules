rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAdminRecord(adminId) {
      return adminId is string &&
          adminId.size() > 0 &&
          firestore.exists(
            /databases/(default)/documents/admins/$(adminId)
          );
    }

    function isAdmin() {
      return isSignedIn() &&
          (hasAdminRecord(request.auth.uid) ||
              hasAdminRecord(request.auth.token.email));
    }

    function isValidImageUpload() {
      return request.resource != null &&
          request.resource.contentType.matches('image/.*') &&
          request.resource.size < 5 * 1024 * 1024;
    }

    match /wiki_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageUpload();
    }

    match /event_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImageUpload();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
